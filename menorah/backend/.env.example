# ── Menorah Health — Production Environment Variables ──────────────────────
# Copy this to .env and fill in all values before starting the server.
# NEVER commit .env to git.
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Keep NODE_ENV=production for staging and set only this selector to staging.
DEPLOYMENT_ENVIRONMENT=production
# Staging only: the exact ten unique *_DOMAIN hosts below, comma-separated.
# Every host must contain `staging` as a full lowercase DNS label; no aliases.
MENORAH_STAGING_ALLOWED_HOSTS=
# Staging only: exact lowercase sender/recipient domain with `staging` as a
# full label. Both CONTACT_TO_EMAIL and EMAIL_FROM must use it.
MENORAH_STAGING_EMAIL_DOMAIN=
ROOT_DOMAIN=menorah.me
WWW_DOMAIN=www.menorah.me
APP_DOMAIN=app.menorah.me
ADMIN_DOMAIN=admin.menorah.me
COUNSELLOR_DOMAIN=counsellor.menorah.me
API_IOS_DOMAIN=api-ios.menorah.me
API_ANDROID_DOMAIN=api-android.menorah.me
API_WEB_DOMAIN=api-web.menorah.me
API_ADMIN_DOMAIN=api-admin.menorah.me
CALLS_DOMAIN=calls.menorah.me
PORT=3000
API_BASE_URL=https://api-web.menorah.me

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — get from Atlas dashboard → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/menorah?retryWrites=true&w=majority
# Self-hosted replica set example for the later migration phase:
# mongodb://mongo-primary:27017,mongo-secondary-vps:27017,mongo-secondary-cloud:27017/menorah?replicaSet=menorah-rs&authSource=admin&retryWrites=true
MONGODB_REPLICA_SET_NAME=menorah-rs
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_RETRY_WRITES=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_BACKUP_URI=mongodb://backup-user:<password>@mongo-primary:27017/?replicaSet=menorah-rs&authSource=admin
MONGODB_RESTORE_TEST_URI=mongodb://mongo-restore-test:27017/?replicaSet=menorah-restore-rs

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — used for rate limiting + Socket.IO multi-process adapter.
# VPS: redis://localhost:6379  (local Redis on same machine)
# Upstash: rediss://:password@host:port  (TLS, free tier available)
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# MUST be ≥ 64 chars — server exits on startup if missing or too short
JWT_SECRET=REPLACE
JWT_ISSUER=menorah-api
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_HEX
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=30m
ADMIN_MFA_REQUIRED=true
# Exact immediate reverse-proxy IP/CIDR only. Never use true, a hop count, or
# private_ranges in production. Production Compose derives this from CADDY_APP_IP.
TRUST_PROXY=10.253.251.2
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CONFIRM=create-admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (no trailing slash)
ALLOWED_ORIGINS=https://www.menorah.me,https://app.menorah.me,https://admin.menorah.me,https://counsellor.menorah.me
# Origin-to-role map for API-issued browser session cookies
WEB_SESSION_ORIGINS=https://www.menorah.me=user,https://app.menorah.me=user,https://counsellor.menorah.me=counsellor,https://admin.menorah.me=admin
FRONTEND_API_WEB_URL=https://api-web.menorah.me/api
FRONTEND_API_ADMIN_URL=https://api-admin.menorah.me/api
FRONTEND_SOCKET_WEB_URL=https://api-web.menorah.me

# Email (Resend transactional email)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM="Menorah Health <noreply@menorah.me>"
CONTACT_TO_EMAIL=menorahenquiries@gmail.com

# ── Razorpay — Payments ───────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys  (use LIVE keys in production)
RAZORPAY_KEY_ID=rzp_live_REPLACE
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
# Webhook secret — Razorpay Dashboard → Webhooks → your webhook → copy secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Optional only during a planned rotation grace period. Keep empty normally and
# remove it after the approved retry/replay window.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Exact opt-in for new booking orders; webhook reconciliation stays available.
BOOKING_PAYMENTS_ENABLED=false
# Exact opt-in for new payout requests/approvals. Payout webhook reconciliation
# stays available while false.
PAYOUTS_ENABLED=false
# OWNER ACTION: choose a bounded processing-attempt limit before enabling new
# booking payments. Leave empty while the initiation gate remains false.
PAYMENT_WEBHOOK_MAX_PROCESSING_ATTEMPTS=
# Reserved for a future durable subscription flow. The backend currently rejects it.
SUBSCRIPTION_PAYMENTS_ENABLED=false
CHECKOUT_RETURN_URL=https://app.menorah.me/checkout/return
# OWNER ACTION: replace this placeholder with the approved INR service catalog.
# Format: {"service-code":{"durationMinutes":60,"amountMinor":<approved-paise>,"currency":"INR"}}
# Enabled clients currently request basic, premium, pro, and unassigned-30/45/60/90.
BOOKING_SERVICE_CATALOG_JSON='REPLACE_WITH_APPROVED_SERVER_PRICING_JSON'

# ── Razorpay X — Payout API (counsellor payouts) ─────────────────────────────
# Activate at: https://razorpay.com/payouts/
# Keys: Razorpay Dashboard → Settings → API Keys → switch to RazorpayX tab
RAZORPAY_X_KEY_ID=REPLACE_WITH_RAZORPAY_X_KEY_ID
RAZORPAY_X_KEY_SECRET=REPLACE_WITH_RAZORPAY_X_KEY_SECRET
# Settlement account number registered with Razorpay X
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=REPLACE_WITH_PAYOUT_ACCOUNT_NUMBER
# Payout webhook secret — Razorpay Dashboard → Webhooks → select payout.* events
# Webhook URL to register: https://api-admin.menorah.me/api/payouts/webhook
RAZORPAY_X_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_X_WEBHOOK_SECRET

# ── Video Calls — LiveKit ─────────────────────────────────────────────────────
# Self-hosted LiveKit SFU (see https://docs.livekit.io/oss/deployment)
# Generate key:    openssl rand -hex 16
# Generate secret: openssl rand -hex 32
LIVEKIT_URL=wss://calls.menorah.me
LIVEKIT_API_URL=https://calls.menorah.me
# Explicit public HTTPS API origin used for signed mobile browser-call links.
PUBLIC_API_ORIGIN=https://api-web.menorah.me
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
# Hybrid calling policy:
# - India users receive in-app LiveKit/WebRTC.
# - UAE users are blocked from LiveKit and must use an approved external provider link.
# - Unknown regions are blocked by default until classified.
CALLING_REGION_MODE=hybrid
LIVEKIT_BLOCKED_COUNTRIES=AE
CALL_JOIN_EARLY_MINUTES=15
CALL_JOIN_LATE_GRACE_MINUTES=15
VIDEO_MEET_TICKET_TTL_SECONDS=120
BLOCKED_COUNTRY_CALL_PROVIDER=zoom
BLOCK_LIVEKIT_FOR_UAE=true
BLOCK_LIVEKIT_FOR_UNKNOWN_REGION=false
UAE_CALL_PROVIDER=zoom
UAE_CALLING_ENABLED=true
VSEE_ENABLED=true
VSEE_INTEGRATION_MODE=external_link
DOXY_ENABLED=false
ZOOM_ENABLED=true
GOOGLE_MEET_ENABLED=false
TEAMS_ENABLED=false

# ── Social Auth ──────────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_OAUTH_CLIENT_ID
GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_GOOGLE_IOS_OAUTH_CLIENT_ID
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_GOOGLE_ANDROID_OAUTH_CLIENT_ID
# Production requires true and the canonical bundle ID plus complete credentials.
# Staging may set false, or true with a complete staging Apple configuration.
APPLE_SIGN_IN_ENABLED=true
APPLE_IOS_BUNDLE_ID=com.menorah.health.app
# Only required if Apple web/service-ID login is added later.
APPLE_WEB_SERVICE_ID=
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
# PKCS#8 key with literal newlines or escaped \n sequences. Keep only in the approved secret store.
APPLE_PRIVATE_KEY=REPLACE_WITH_APPLE_PRIVATE_KEY

# ── Cloudinary (image / file uploads) ────────────────────────────────────────
# Get from Cloudinary dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET

# -- Luxand eKYC - Face detection ---------------------------------------------
# Get from Luxand Cloud dashboard. Used by /api/ekyc/submit.
LUXAND_API_TOKEN=REPLACE_WITH_LUXAND_TOKEN
LUXAND_DETECT_URL=https://api.luxand.cloud/photo/detect
LUXAND_FACE_CONFIDENCE_THRESHOLD=90
EKYC_MAX_FILE_SIZE=15728640

# AI Social Studio
# AI_MOCK_MODE is for local development only.
# Use SOCIAL_STUDIO_OPENAI_API_KEY for Social Studio so article generation can keep a separate OpenAI key.
# If SOCIAL_STUDIO_OPENAI_API_KEY is empty, Social Studio falls back to OPENAI_API_KEY.
SOCIAL_STUDIO_ENABLED=true
SOCIAL_STUDIO_AUTO_PUBLISH=false
SOCIAL_STUDIO_GENERATION_RATE_LIMIT=10
SOCIAL_STUDIO_MAX_POSTS_PER_RUN=20
# Production uses the single immutable local media namespace below. Do not set
# the retired SOCIAL_STUDIO_STORAGE or COUNSELLOR_MEDIA_STORAGE selectors.
# Reel uploads are limited independently from regular image uploads. The
# reverse proxy must use the same MB value for the single Reel endpoint.
SOCIAL_STUDIO_VIDEO_UPLOAD_RATE_LIMIT=10
SOCIAL_STUDIO_MAX_VIDEO_SIZE_MB=50
# Reverse proxies need a small multipart-overhead allowance above the file cap.
SOCIAL_STUDIO_MAX_VIDEO_REQUEST_SIZE_MB=55
# Optional byte-level override for non-Compose deployments.
SOCIAL_STUDIO_MAX_VIDEO_SIZE_BYTES=
SOCIAL_STUDIO_REEL_READY_ATTEMPTS=12
SOCIAL_STUDIO_REEL_READY_INTERVAL_MS=5000
CLOUDINARY_SOCIAL_STUDIO_FOLDER=menorah/social-studio
CLOUDINARY_SOCIAL_STUDIO_ASSET_FOLDER=menorah/social-studio-assets
CLOUDINARY_SOCIAL_STUDIO_VIDEO_FOLDER=menorah/social-studio-videos
AI_PROVIDER=openai
AI_MOCK_MODE=true
SOCIAL_STUDIO_AI_PROVIDER=openai
SOCIAL_STUDIO_OPENAI_API_KEY=
SOCIAL_STUDIO_AI_TEXT_MODEL=gpt-4o-mini
SOCIAL_STUDIO_AI_IMAGE_MODEL=gpt-image-2
SOCIAL_STUDIO_AI_IMAGE_SIZE=1536x1024
SOCIAL_STUDIO_AI_IMAGE_QUALITY=medium
SOCIAL_STUDIO_AI_IMAGE_FORMAT=jpeg
SOCIAL_STUDIO_AI_IMAGE_TIMEOUT_MS=120000
OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=

# Meta / Instagram publishing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
SOCIAL_TOKEN_ENCRYPTION_KEY=
PUBLIC_WEB_BASE_URL=https://www.menorah.me
# Canonical HTML article origin. Keep this separate from PUBLIC_WEB_BASE_URL.
ARTICLE_CANONICAL_BASE_URL=https://menorah.me

# ── Socket.IO Redis adapter ───────────────────────────────────────────────────
# Set to "false" on Cloud Run ONLY — Cloud Run receives no socket.io traffic
# (Cloudflare Worker pins all /socket.io/ requests to VPS), so the pub/sub
# pair is wasted. Leave unset or "true" on VPS.
ENABLE_SOCKET_ADAPTER=true

# ── Worker / Expo push security ─────────────────────────────────────────────
# API containers use standby/false. Override only the single designated worker
# to active/true. Its Expo token is a protected secret and must never be logged.
WORKER_MODE=standby
ENABLE_NOTIFICATION_JOBS=false
EXPO_PUSH_ACCESS_TOKEN=

# ── Rate limiting (optional overrides) ───────────────────────────────────────
AUTH_RATE_LIMIT_MAX=10
RESET_PASSWORD_IP_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ── Misc ─────────────────────────────────────────────────────────────────────
SERVER_TZ=Asia/Kolkata
BCRYPT_ROUNDS=12
# Max file upload size in bytes (5 MB)
MAX_FILE_SIZE=5242880
MEDIA_STORAGE_BACKEND=local
MEDIA_PUBLIC_BASE_URL=https://api-web.menorah.me
UPLOAD_PATH=./uploads
SERVER_USAGE_LABEL=On-prem server
SERVER_USAGE_PATH=./uploads
MENORAH_BACKUP_ROOT=/mnt/menorah-backups
BACKUP_AUTOMATION_ENABLED=true
BACKUP_EXPECT_RAID=true
BACKUP_RAID_DEVICE=/dev/md/menorah-backups
BACKUP_MAX_AGE_HOURS=24
BACKUP_RESTORE_TEST_MAX_AGE_HOURS=24
BACKUP_DISK_USAGE_MAX_PERCENT=80
BACKUP_COLD_STORAGE_LABEL="2 TB cold storage HDD"
SIX_HOURLY_RETENTION_DAYS=7
DAILY_RETENTION_DAYS=30
WEEKLY_RETENTION_DAYS=84
MONTHLY_RETENTION_DAYS=366
# Password reset links use a URL fragment so the token is never sent to proxies.
# Publish Android App Links at https://app.menorah.me/.well-known/assetlinks.json.
# Staging must replace this with its own non-production HTTPS origin.
PASSWORD_RESET_BASE_URL=https://app.menorah.me

# eKYC retention and consent evidence. Do not lower retention without legal approval.
KYC_CONSENT_VERSION=ordinary-face-check-v1-2026-07-22
KYC_RETENTION_DAYS=365
# LEGAL ACTION / PRIVACY ACTION: approve the notice and every retention category.
PRIVACY_NOTICE_VERSION=REPLACE_WITH_APPROVED_PRIVACY_NOTICE_VERSION
PRIVACY_RETENTION_EXECUTION_ENABLED=false
PRIVACY_ADMIN_PERMISSION_GRANTS_JSON='[{"adminId":"REPLACE_WITH_APPROVED_ADMIN_OBJECT_ID","permissions":["privacy_reader","privacy_reviewer","privacy_legal_hold"]}]'
# OWNER ACTION: map every active admin account to exactly one operational role.
# Accepted roles: admin, support, finance, content. At least one admin is required.
ADMIN_ROLE_GRANTS_JSON='[{"adminId":"REPLACE_WITH_APPROVED_ADMIN_OBJECT_ID","role":"admin"}]'
PRIVACY_RETENTION_POLICY_JSON='{"version":"REPLACE_WITH_APPROVED_RETENTION_POLICY_VERSION","categories":{"account_profile":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"booking_clinical":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"chat_content":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"call_metadata":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"payment_finance":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"security_audit":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"privacy_consent_evidence":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"privacy_rights_request_payload":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"face_check_metadata":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"backups":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"operational_logs":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"vendor_copies":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"}}}'
# Optional bounded worker batch size (1-100); execution remains disabled above.
PRIVACY_RETENTION_BATCH_SIZE=25
# LEGAL ACTION: replace these only after the counsellor notice and policy are approved.
COUNSELLOR_ONBOARDING_CONSENT_VERSION=REPLACE_WITH_APPROVED_COUNSELLOR_ONBOARDING_CONSENT_VERSION
COUNSELLOR_CREDENTIAL_POLICY_VERSION=REPLACE_WITH_APPROVED_COUNSELLOR_CREDENTIAL_POLICY_VERSION
COUNSELLOR_ONBOARDING_NOTICE_URL=https://REPLACE_WITH_APPROVED_COUNSELLOR_NOTICE_URL
# Finance-approved per-payout limit, expressed in paise.
MAX_PAYOUT_AMOUNT_PAISE=5000000

# High-entropy secret used for AES-256-GCM encryption of counsellor bank accounts.
# Keep this only in the approved production secret store. Rotation requires re-encryption.
DATA_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Separate high-entropy HMAC key for tamper-evident security audit events.
AUDIT_LOG_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional bounded in-process retry queue; accepted range 128-8192.
SECURITY_AUDIT_PENDING_MAX=1024
