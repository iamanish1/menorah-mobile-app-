{
  "name": "menorah-backend",
  "version": "1.0.0",
  "description": "Backend API for Menorah Health mobile application",
  "main": "src/services/api-web/server.js",
  "scripts": {
    "start": "npm run start:api-web",
    "dev": "nodemon src/services/api-web/server.js",
    "start:api-ios": "node src/services/api-ios/server.js",
    "start:api-android": "node src/services/api-android/server.js",
    "start:api-web": "node src/services/api-web/server.js",
    "start:api-admin": "node src/services/api-admin/server.js",
    "start:worker": "node src/services/worker/worker.js",
    "test": "jest",
    "lint": "eslint src/",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "seed:qa": "node src/database/seed-qa.js"
  },
  "keywords": [
    "menorah",
    "health",
    "counselling",
    "api"
  ],
  "author": "Menorah Health Team",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.4",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.13.0",
    "node-cron": "^4.5.0",
    "rate-limit-redis": "^5.0.0",
    "rate-limiter-flexible": "^2.4.2",
    "razorpay": "^2.8.6",
    "redis": "^6.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.4",
    "stompjs": "^2.3.3",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/node_modules.root-owned-"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules.root-owned-"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/node_modules.root-owned-"
    ]
  }
}
