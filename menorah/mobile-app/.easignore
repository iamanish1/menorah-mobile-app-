# Dependencies
node_modules/
**/node_modules/

# Build artifacts
android/app/build/
android/build/
ios/build/
*.apk
*.aab
*.ipa

# Development files
.git/
.vscode/
.idea/
*.log
*.swp
*.swo
*~

# Local environment files. Production build values must come from the selected
# EAS environment; no developer dotenv file belongs in the upload archive.
.env
.env.*
!.env.example

# Signing credentials and provider secrets. `.easignore` takes precedence over
# `.gitignore`, so these rules must remain duplicated here.
credentials.json
credentials/
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
upload_certificate*.pem

# Firebase configuration is supplied only as the protected EAS file variable
# GOOGLE_SERVICES_JSON and installed by the fail-closed build hook.
google-services.json
GoogleService-Info.plist
android/app/google-services.json
android/app/.google-services-prepared
firebase-adminsdk-*.json
service-account*.json
*-service-account.json
fcm-service-account*.json
google-play-service-account*.json
play-store-credentials*.json

# Documentation
*.md
!README.md

# Test files
**/__tests__/
**/*.test.*
**/*.spec.*

# Misc
.DS_Store
Thumbs.db
*.orig

# Backend (not needed for mobile build)
../backend/

# Web app (not needed for mobile build)
../web-app/

# Large assets that aren't needed
**/*.psd
**/*.ai
**/*.sketch
