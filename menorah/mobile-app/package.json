{
  "name": "menorah-health-app",
  "version": "2.7.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "test:payment-policy": "node --test scripts/payment-policy-contract.test.cjs",
    "test:first-login-tour": "node --test scripts/first-login-tour-contract.test.cjs",
    "test:discover-counsellors": "node --test scripts/discover-counsellor-section-contract.test.cjs",
    "test:hourly-pricing": "node --test scripts/hourly-counsellor-pricing-contract.test.cjs",
    "test:completed-sessions": "node --test scripts/completed-session-count-contract.test.cjs",
    "test:mental-health-check-in": "node --test scripts/mental-health-check-in-contract.test.cjs",
    "test:chat-sync": "node --test scripts/chat-sync-contract.test.cjs",
    "test:android-push": "node --test scripts/android-push-notifications-contract.test.cjs",
    "test:push-lifecycle": "node --test scripts/push-device-lifecycle-policy.test.cjs",
    "test:google-services-hook": "node --test scripts/google-services-build-hook.test.cjs",
    "test:android-artifact-inspector": "node --test scripts/android-artifact-inspector.test.cjs",
    "test:release-config": "node --test scripts/mobile-release-config.test.cjs",
    "validate:release-config": "node scripts/validate-mobile-release-config.cjs",
    "inspect:android-aab": "node scripts/inspect-android-aab.cjs",
    "inspect:play-apk": "node scripts/inspect-play-delivered-apk.cjs",
    "eas-build-post-install": "node scripts/prepare-google-services.cjs",
    "eas-build-on-complete": "node scripts/cleanup-google-services.cjs",
    "eas-build-on-cancel": "node scripts/cleanup-google-services.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:preview": "eas build --profile preview-android --platform android",
    "build:production": "eas build --profile production-android --platform android",
    "build:ios:preview": "eas build --profile preview-ios --platform ios",
    "build:ios:production": "eas build --profile production-ios --platform ios",
    "update": "eas update --channel production --environment production --message",
    "update:preview": "eas update --channel preview --environment preview --message"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.85.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "events": "^3.3.0",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.10",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "i18next": "^26.3.6",
    "lucide-react-native": "^0.539.0",
    "postcss": "^8.4.32",
    "process": "^0.11.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-razorpay": "^2.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.7.2",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "util": "^0.12.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "~57.0.8",
    "@expo/metro-runtime": "~57.0.8",
    "@react-native/eslint-config": "^0.81.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.1",
    "expo-doctor": "1.20.1",
    "prettier": "^3.6.2",
    "react-refresh": "^0.18.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  }
}
