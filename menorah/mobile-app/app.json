    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "d7fb6e65-3440-4a79-b4b2-6746d2582fa7"
