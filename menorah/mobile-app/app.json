{
  "expo": {
    "name": "Menorah Health",
    "slug": "menorah-health-app",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/brand/menorah_logo.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menorah.health.app",
      "buildNumber": "14",
      "associatedDomains": [
        "applinks:app.menorah.me"
      ]
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_PHONE_STATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/menorah-logo-no-bg.png",
        "backgroundColor": "#f0f9f4"
      },
      "package": "com.menorah.healthmobile",
      "versionCode": 14
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#2d7a5c",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "splash": {
        "image": "./assets/brand/menorah_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#f0f9f4"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2d7a5c",
          "defaultChannel": "general"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/d7fb6e65-3440-4a79-b4b2-6746d2582fa7"
    },
    "runtimeVersion": "2.6.0",
    "extra": {
      "CHECKOUT_RETURN_URL": "https://menorah.me/checkout/return",
      "eas": {
        "projectId": "d7fb6e65-3440-4a79-b4b2-6746d2582fa7"
      }
    },
    "owner": "menorahsoftware"
  }
}
