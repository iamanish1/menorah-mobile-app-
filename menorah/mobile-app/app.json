{
  "expo": {
    "name": "Menorah Health",
    "slug": "menorah-health-app",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/brand/menorah_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f9f4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menorah.health.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/menorah_logo.png",
        "backgroundColor": "#f0f9f4"
      },
      "package": "com.menorah.healthmobile",
      "versionCode": 11,
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#314830",
        "translucent": false
      },
      "navigationBar": {
        "visible": "leanback",
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [],
    "updates": {
      "url": "https://u.expo.dev/d7fb6e65-3440-4a79-b4b2-6746d2582fa7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "API_BASE_URL": "https://api.menorah.me/api",
      "CHECKOUT_RETURN_URL": "https://menorah.me/checkout/return",
      "eas": {
        "projectId": "d7fb6e65-3440-4a79-b4b2-6746d2582fa7"
      }
    },
    "owner": "menorahsoftware"
  }
}
