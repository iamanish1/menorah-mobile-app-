FROM mongo:7@sha256:340c1c56fb10e95cf79ff547f8664b96bc6ead9909bc355238cbf865a9695a6f

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      coreutils \
      diffutils \
      findutils \
      grep \
      gzip \
      openssl \
      perl \
      sed \
      tar \
      wget \
    ; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    for executable in \
      cmp \
      find \
      grep \
      gzip \
      mongodump \
      mongorestore \
      mongosh \
      openssl \
      readlink \
      sed \
      sha256sum \
      sort \
      tar \
      wget \
      xargs \
    ; do \
      command -v "${executable}"; \
    done; \
    perl -MDigest::SHA=hmac_sha256_hex -e \
      'exit(hmac_sha256_hex("payload", "key") ? 0 : 1)'
