PROMETHEUS_EXTERNAL_ENVIRONMENT=staging
PROMETHEUS_EXTERNAL_PROJECT=menorah-staging
ALERTMANAGER_ENVIRONMENT=staging
# This source remains outside Git, must resolve exactly to this canonical path,
# and must be a regular non-symlink file owned by uid/gid 65534 with mode 0400.
# Record the SHA-256 of its exact bytes only after staging receiver review.
ALERTMANAGER_CONFIG_SOURCE=/opt/menorah-staging/env/alertmanager.yml
ALERTMANAGER_CONFIG_FILE=/etc/alertmanager/alertmanager.yml
ALERTMANAGER_CONFIG_SHA256=<replace-with-rendered-staging-alertmanager-sha256>
ALERTMANAGER_RECEIVER=<replace-with-menorah-staging-receiver-name>
ALERTMANAGER_DELIVERY_RECEIVER=<replace-with-same-menorah-staging-receiver-name>
ALERTMANAGER_DELIVERY_ENDPOINT_HOST=<replace-with-reviewed-staging-alert-endpoint-host>
# These two fields record a fresh review of the exact digest-bound
# configuration. They are not evidence that a notification was delivered,
# acknowledged, escalated or resolved; that evidence is collected after start.
ALERTMANAGER_CONFIG_REVIEWED_AT=<replace-with-config-review-timestamp>
ALERTMANAGER_CONFIG_REVIEW_REFERENCE=<replace-with-config-review-reference>

PRIVACY_RETENTION_EXECUTION_ENABLED=false
PRIVACY_RETENTION_BATCH_SIZE=25
PRIVACY_RETENTION_POLICY_JSON={"version":"synthetic-server-staging-retention-v1","categories":{"account_profile":{"mode":"manual","policyReference":"synthetic-server-staging-account_profile-manual-v1"},"booking_clinical":{"mode":"manual","policyReference":"synthetic-server-staging-booking_clinical-manual-v1"},"chat_content":{"mode":"manual","policyReference":"synthetic-server-staging-chat_content-manual-v1"},"call_metadata":{"mode":"manual","policyReference":"synthetic-server-staging-call_metadata-manual-v1"},"payment_finance":{"mode":"manual","policyReference":"synthetic-server-staging-payment_finance-manual-v1"},"security_audit":{"mode":"manual","policyReference":"synthetic-server-staging-security_audit-manual-v1"},"privacy_consent_evidence":{"mode":"manual","policyReference":"synthetic-server-staging-privacy_consent_evidence-manual-v1"},"privacy_rights_request_payload":{"mode":"manual","policyReference":"synthetic-server-staging-privacy_rights_request_payload-manual-v1"},"face_check_metadata":{"mode":"manual","policyReference":"synthetic-server-staging-face_check_metadata-manual-v1"},"backups":{"mode":"manual","policyReference":"synthetic-server-staging-backups-manual-v1"},"operational_logs":{"mode":"manual","policyReference":"synthetic-server-staging-operational_logs-manual-v1"},"vendor_copies":{"mode":"manual","policyReference":"synthetic-server-staging-vendor_copies-manual-v1"}}}
PRIVACY_ADMIN_PERMISSION_GRANTS_JSON=[{"adminId":"7a110ca15a6e000000000104","permissions":["privacy_reader","privacy_reviewer","privacy_legal_hold"]}]
ADMIN_ROLE_GRANTS_JSON=[{"adminId":"7a110ca15a6e000000000101","role":"support"},{"adminId":"7a110ca15a6e000000000102","role":"finance"},{"adminId":"7a110ca15a6e000000000103","role":"content"},{"adminId":"7a110ca15a6e000000000104","role":"admin"},{"adminId":"7a110ca15a6e000000000105","role":"admin"}]
BOOKING_SERVICE_CATALOG_JSON=<replace-with-synthetic-staging-booking-catalog-json>
KYC_CONSENT_VERSION=ordinary-face-check-v1-2026-07-22
KYC_RETENTION_DAYS=365
PRIVACY_NOTICE_VERSION=synthetic-server-staging-privacy-notice-v1
COUNSELLOR_ONBOARDING_CONSENT_VERSION=synthetic-server-staging-counsellor-consent-v1
COUNSELLOR_CREDENTIAL_POLICY_VERSION=synthetic-server-staging-credential-policy-v1
SECURITY_AUDIT_PENDING_MAX=1024

# The seed profile is a separate, explicit synthetic-data operation. Its
# confirmation and ten generated role passwords are intentionally absent from
# this persistent real-server contract; inject them only for that bounded run.
