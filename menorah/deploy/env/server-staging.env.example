# Menorah co-host server staging environment contract.
#
# Copy this file to /opt/menorah-staging/env/server-staging.env outside Git,
# replace every <replace-with-...> value, chmod it 0600, and run the validator.
# This tracked example is intentionally NOT a runnable environment file.

NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
SERVICE_RUNTIME=server-staging
MENORAH_SYNTHETIC_DATA_ONLY=true
# Compose takes its persistent project identity from this application-specific
# key. COMPOSE_PROJECT_NAME and other Docker/Git/Compose controls must be set,
# if needed, only in the invoking process and are forbidden in this file.
MENORAH_SERVER_STAGING_PROJECT_NAME=menorah-staging
MENORAH_SERVER_STAGING_RESOURCE_PREFIX=menorah-staging
MENORAH_SERVER_STAGING_ENVIRONMENT_ID=menorah-server-staging-v1
MENORAH_RUNTIME_CANDIDATE_SHA=<replace-with-exact-lowercase-40-character-runtime-sha>
MENORAH_SERVER_STAGING_RUNTIME_SHA=<replace-with-same-exact-lowercase-40-character-runtime-sha>

MENORAH_SERVER_STAGING_ROOT=/opt/menorah-staging
MENORAH_SERVER_STAGING_DATA_ROOT=/opt/menorah-staging/data
MENORAH_SERVER_STAGING_BACKUP_ROOT=/opt/menorah-staging/backups
MENORAH_SERVER_STAGING_DEPLOY_STATE_ROOT=/opt/menorah-staging/deploy-state
MENORAH_SERVER_STAGING_LOGS_ROOT=/opt/menorah-staging/logs
MENORAH_SERVER_STAGING_ENV_ROOT=/opt/menorah-staging/env
MENORAH_SERVER_STAGING_APP_ROOT=/opt/menorah-staging/app
MENORAH_DATA_ROOT=/opt/menorah-staging/data
MENORAH_BACKUP_ROOT=/opt/menorah-staging/backups
MENORAH_DEPLOY_STATE_ROOT=/opt/menorah-staging/deploy-state
MENORAH_LOG_ROOT=/opt/menorah-staging/logs
MENORAH_ENV_ROOT=/opt/menorah-staging/env
MENORAH_APP_ROOT=/opt/menorah-staging/app
MENORAH_RESTORE_ROOT=/opt/menorah-staging/data/restore
MENORAH_RETRIEVAL_ROOT=/opt/menorah-staging/data/backup-retrieval
MENORAH_MIGRATION_TEMP_ROOT=/opt/menorah-staging/data/migration-tmp
MENORAH_SERVER_STAGING_ENV_FILE=/opt/menorah-staging/env/server-staging.env
MENORAH_SERVER_STAGING_MONGO_KEYFILE=/opt/menorah-staging/env/mongo-keyfile
MENORAH_SERVER_STAGING_BACKUP_PASSWORD_FILE=/opt/menorah-staging/env/backup-encryption-password
MENORAH_SERVER_STAGING_BACKUP_HMAC_FILE=/opt/menorah-staging/env/backup-integrity-hmac-key

