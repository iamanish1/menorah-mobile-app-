RESEND_PROVIDER_ENABLED=false
RESEND_MODE=sandbox
RESEND_API_URL=
RESEND_API_KEY=
MAIL_CAPTURE_API_KEY=re_server_staging_<replace-with-at-least-32-random-characters>
RESEND_WEBHOOK_SECRET=

