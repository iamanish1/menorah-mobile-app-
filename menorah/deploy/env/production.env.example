# Copy this file to production.env on the Ubuntu host. Never commit production.env.

NODE_ENV=production
# Keep NODE_ENV=production in staging so every production hardening check runs.
# Set this selector to staging only in an isolated staging environment.
DEPLOYMENT_ENVIRONMENT=production
# Staging only: exactly ten unique lowercase hosts, each with `staging` as a
# full DNS label. List the ten *_DOMAIN values below, comma-separated; no aliases.
MENORAH_STAGING_ALLOWED_HOSTS=
# Staging only: the exact sender/recipient email domain. It must be lowercase
# DNS and contain `staging` as a full label.
MENORAH_STAGING_EMAIL_DOMAIN=
SERVICE_RUNTIME=home

PUBLIC_EMAIL=admin@example.com
ROOT_DOMAIN=menorah.me
WWW_DOMAIN=www.menorah.me
APP_DOMAIN=app.menorah.me
ADMIN_DOMAIN=admin.menorah.me
COUNSELLOR_DOMAIN=counsellor.menorah.me
API_IOS_DOMAIN=api-ios.menorah.me
API_ANDROID_DOMAIN=api-android.menorah.me
API_WEB_DOMAIN=api-web.menorah.me
API_ADMIN_DOMAIN=api-admin.menorah.me
CALLS_DOMAIN=calls.menorah.me
LIVEKIT_UPSTREAM=http://livekit:7880
LIVEKIT_URL=wss://calls.menorah.me
LIVEKIT_API_URL=https://calls.menorah.me
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
LIVEKIT_NODE_IP=REPLACE_WITH_HOST_PUBLIC_IPV4_IF_AUTO_DETECTION_FAILS
LIVEKIT_CONFIG_FILE=/opt/menorah/secrets/livekit.yaml
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_RANGE=50000-50100
CALLING_REGION_MODE=hybrid
LIVEKIT_BLOCKED_COUNTRIES=AE
CALL_JOIN_EARLY_MINUTES=15
CALL_JOIN_LATE_GRACE_MINUTES=15
VIDEO_MEET_TICKET_TTL_SECONDS=120
BLOCKED_COUNTRY_CALL_PROVIDER=zoom
BLOCK_LIVEKIT_FOR_UAE=true
BLOCK_LIVEKIT_FOR_UNKNOWN_REGION=false
UAE_CALL_PROVIDER=zoom
UAE_CALLING_ENABLED=true
VSEE_ENABLED=true
VSEE_INTEGRATION_MODE=external_link
DOXY_ENABLED=false
ZOOM_ENABLED=true
GOOGLE_MEET_ENABLED=false
TEAMS_ENABLED=false

MENORAH_DATA_ROOT=/opt/menorah/data
MENORAH_BACKUP_ROOT=/mnt/menorah-backups
MENORAH_SECRETS_ROOT=/opt/menorah/secrets
MONGO_KEYFILE_PATH=/opt/menorah/secrets/mongo-keyfile

# Admin Server Usage page.
# SERVER_USAGE_* describes the machine running the admin API.
SERVER_USAGE_LABEL=On-prem server
SERVER_USAGE_PATH=/app/uploads

# Managed production media is immutable local data on the shared upload mount.
# Cloudinary credentials may remain configured for an explicitly reviewed
# migration, but production startup rejects provider-backed managed media.
MEDIA_STORAGE_BACKEND=local
MEDIA_PUBLIC_BASE_URL=https://api-web.menorah.me
UPLOAD_PATH=/app/uploads

MONGO_ROOT_USER=menorah-root
MONGO_ROOT_PASSWORD=replace_with_strong_mongo_root_password
MONGO_APP_USER=menorah-app
MONGO_APP_PASSWORD=replace_with_strong_mongo_app_password
MONGO_BACKUP_USER=menorah-backup
MONGO_BACKUP_PASSWORD=replace_with_strong_mongo_backup_password
MONGO_RESTORE_USER=menorah-production-restore
MONGO_RESTORE_PASSWORD=replace_with_strong_mongo_restore_password
MONGO_MONITOR_USER=menorah-monitor
MONGO_MONITOR_PASSWORD=replace_with_strong_mongo_monitor_password
MONGODB_URI='mongodb://menorah-app:replace_with_strong_mongo_app_password@mongo-primary:27017/menorah?replicaSet=menorah-rs&authSource=admin&retryWrites=true'
MONGODB_BACKUP_URI='mongodb://menorah-backup:replace_with_strong_mongo_backup_password@mongo-primary:27017/?replicaSet=menorah-rs&authSource=admin'
MONGODB_PRODUCTION_RESTORE_URI='mongodb://menorah-production-restore:replace_with_strong_mongo_restore_password@mongo-primary:27017/?replicaSet=menorah-rs&authSource=admin'
MONGODB_MONITORING_URI=mongodb://menorah-monitor:replace_with_strong_mongo_monitor_password@mongo-primary:27017/admin?authSource=admin
MONGODB_RESTORE_TEST_URI=mongodb://mongo-restore-test:27017/?replicaSet=menorah-restore-rs
MONGODB_REPLICA_SET_NAME=menorah-rs
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_RETRY_WRITES=true
REDIS_URL=redis://redis:6379
REDIS_MONITORING_URL=redis://redis:6379

JWT_SECRET=replace_with_64_plus_character_random_secret
JWT_REFRESH_SECRET=replace_with_different_64_plus_character_random_secret
JWT_ISSUER=menorah-api
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=30m
ADMIN_MFA_REQUIRED=true
MAX_PAYOUT_AMOUNT_PAISE=5000000
KYC_CONSENT_VERSION=ordinary-face-check-v1-2026-07-22
KYC_RETENTION_DAYS=365
# LEGAL ACTION / PRIVACY ACTION: approve the notice and every retention category.
PRIVACY_NOTICE_VERSION=REPLACE_WITH_APPROVED_PRIVACY_NOTICE_VERSION
ADMIN_ROLE_GRANTS_JSON='[{"adminId":"REPLACE_WITH_APPROVED_ADMIN_OBJECT_ID","role":"admin"}]'
PRIVACY_RETENTION_EXECUTION_ENABLED=false
PRIVACY_ADMIN_PERMISSION_GRANTS_JSON='[{"adminId":"REPLACE_WITH_APPROVED_ADMIN_OBJECT_ID","permissions":["privacy_reader","privacy_reviewer","privacy_legal_hold"]}]'
PRIVACY_RETENTION_POLICY_JSON='{"version":"REPLACE_WITH_APPROVED_RETENTION_POLICY_VERSION","categories":{"account_profile":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"booking_clinical":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"chat_content":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"call_metadata":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"payment_finance":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"security_audit":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"privacy_consent_evidence":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"privacy_rights_request_payload":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"face_check_metadata":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"backups":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"operational_logs":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"},"vendor_copies":{"mode":"manual","policyReference":"REPLACE_WITH_APPROVED_REFERENCE"}}}'
PRIVACY_RETENTION_BATCH_SIZE=25
# LEGAL ACTION: production remains fail-closed until these values are approved.
COUNSELLOR_ONBOARDING_CONSENT_VERSION=REPLACE_WITH_APPROVED_COUNSELLOR_ONBOARDING_CONSENT_VERSION
COUNSELLOR_CREDENTIAL_POLICY_VERSION=REPLACE_WITH_APPROVED_COUNSELLOR_CREDENTIAL_POLICY_VERSION
COUNSELLOR_ONBOARDING_NOTICE_URL=https://REPLACE_WITH_APPROVED_COUNSELLOR_NOTICE_URL
DATA_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUDIT_LOG_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SECURITY_AUDIT_PENDING_MAX=1024
# Dedicated tunnel/Caddy and Caddy/application trust boundaries. Verify these
# subnets do not overlap host/VPN/LAN routes before first deployment.
TUNNEL_INGRESS_SUBNET=10.253.250.0/29
CADDY_TUNNEL_IP=10.253.250.2
CLOUDFLARED_TUNNEL_IP=10.253.250.3
APP_NETWORK_SUBNET=10.253.251.0/24
CADDY_APP_IP=10.253.251.2
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CONFIRM=create-admin
ALLOWED_ORIGINS=https://www.menorah.me,https://app.menorah.me,https://admin.menorah.me,https://counsellor.menorah.me
WEB_SESSION_ORIGINS=https://www.menorah.me=user,https://app.menorah.me=user,https://counsellor.menorah.me=counsellor,https://admin.menorah.me=admin

ENABLE_SOCKET_IO=true
ENABLE_SOCKET_ADAPTER=true

WORKER_MODE=active
ENABLE_ARTICLE_SCHEDULER=true
ENABLE_SOCIAL_SCHEDULER=false
ENABLE_BACKUP_JOBS=false
ENABLE_EMAIL_JOBS=false
ENABLE_NOTIFICATION_JOBS=false

RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Planned rotation grace only. Keep empty normally; remove after the approved window.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Dedicated RazorpayX credentials; checkout credentials are never used as a fallback.
RAZORPAY_X_KEY_ID=replace_with_razorpay_x_key_id
RAZORPAY_X_KEY_SECRET=replace_with_razorpay_x_key_secret
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=replace_with_razorpay_x_account_number
# Canonical provider endpoint: https://api-admin.menorah.me/api/payouts/webhook
RAZORPAY_X_WEBHOOK_SECRET=replace_with_razorpay_x_webhook_secret
# Owner opt-in only after booking reconciliation has been approved.
BOOKING_PAYMENTS_ENABLED=false
# Owner opt-in only after payout sandbox, webhook, and finance review.
PAYOUTS_ENABLED=false
# OWNER ACTION: set a bounded attempt count before changing the gate to true.
PAYMENT_WEBHOOK_MAX_PROCESSING_ATTEMPTS=
# Hard-disabled until subscription payments have durable reconciliation.
SUBSCRIPTION_PAYMENTS_ENABLED=false
# OWNER ACTION: configure every enabled booking service with an approved INR amount in paise.
# Example shape only: {"service-code":{"durationMinutes":60,"amountMinor":<approved-paise>,"currency":"INR"}}
# Enabled clients currently request basic, premium, pro, and unassigned-30/45/60/90.
BOOKING_SERVICE_CATALOG_JSON='replace_with_approved_server_pricing_json'
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace_with_public_razorpay_key_id
GOOGLE_WEB_CLIENT_ID=replace_with_google_web_oauth_client_id
GOOGLE_IOS_CLIENT_ID=replace_with_google_ios_oauth_client_id
GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_oauth_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_web_oauth_client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_with_google_web_oauth_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_with_google_ios_oauth_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_oauth_client_id
# Optional override. If blank, mobile app config derives this from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Production requires true and the canonical bundle ID plus complete credentials.
# Staging may set false, or true with a complete staging Apple configuration.
APPLE_SIGN_IN_ENABLED=true
APPLE_IOS_BUNDLE_ID=com.menorah.health.app
# Only required if Apple web/service-ID login is added later.
APPLE_WEB_SERVICE_ID=
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
APPLE_PRIVATE_KEY=REPLACE_WITH_PKCS8_KEY_USING_ESCAPED_NEWLINES

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SIGNING_SECRET
EMAIL_FROM="Menorah Health <noreply@menorah.me>"
CONTACT_TO_EMAIL=menorahenquiries@gmail.com
# Staging must replace this with its own non-production HTTPS origin.
PASSWORD_RESET_BASE_URL=https://app.menorah.me
CHECKOUT_RETURN_URL=https://app.menorah.me/checkout/return

LUXAND_API_TOKEN=replace_with_luxand_api_token
OPENAI_API_KEY=replace_with_openai_api_key

CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

FRONTEND_API_WEB_URL=https://api-web.menorah.me/api
FRONTEND_API_ADMIN_URL=https://api-admin.menorah.me/api
FRONTEND_SOCKET_WEB_URL=https://api-web.menorah.me

# Caddy's production origin is structurally bound to loopback. Configure only
# the local host port; Cloudflare Tunnel is the sole external HTTP ingress.
CADDY_HTTP_PORT=127.0.0.1:8080
MENORAH_MEDIA_GROUP_ID=1000
CLOUDFLARE_ORIGIN_CERT_PATH=/opt/menorah/secrets/cloudflare-origin.pem
CLOUDFLARE_ORIGIN_KEY_PATH=/opt/menorah/secrets/cloudflare-origin-key.pem
CLOUDFLARE_ORIGIN_CERT_FILE=/run/secrets/cloudflare_origin_cert.pem
CLOUDFLARE_ORIGIN_KEY_FILE=/run/secrets/cloudflare_origin_key.pem
LANDING_LOCAL_PORT=127.0.0.1:18085
USER_WEB_APP_LOCAL_PORT=127.0.0.1:18087
WEB_APP_LOCAL_PORT=127.0.0.1:18086
ADMIN_PANEL_LOCAL_PORT=127.0.0.1:18088
API_IOS_LOCAL_PORT=127.0.0.1:18080
API_ANDROID_LOCAL_PORT=127.0.0.1:18084
API_WEB_LOCAL_PORT=127.0.0.1:18082
API_ADMIN_LOCAL_PORT=127.0.0.1:18083
WORKER_LOCAL_PORT=127.0.0.1:18090
GRAFANA_LOCAL_PORT=127.0.0.1:18100
UPTIME_KUMA_LOCAL_PORT=127.0.0.1:18101
ALERTMANAGER_LOCAL_PORT=127.0.0.1:18102
ALERTMANAGER_CONFIG_FILE=/opt/menorah/secrets/alertmanager.yml
ALERTMANAGER_CONFIG_SHA256=replace_with_lowercase_sha256_of_tested_alertmanager_config
ALERTMANAGER_DELIVERY_RECEIVER=replace_with_tested_root_receiver_name
ALERTMANAGER_DELIVERY_VERIFIED_AT=replace_with_recent_rfc3339_delivery_test_time
ALERTMANAGER_DELIVERY_TEST_REFERENCE=replace_with_acknowledged_delivery_evidence_reference

# Production backups should live on the encrypted RAID1 HDD volume.
BACKUP_AUTOMATION_ENABLED=true
# Set this to the production operator's exact numeric `id -u:id -g` so the
# read-only exporter can traverse the operator-owned backup metadata tree.
BACKUP_METRICS_RUN_AS=replace_with_operator_numeric_uid:gid
BACKUP_REQUIRE_MOUNT=true
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_EXPECT_RAID=true
BACKUP_RAID_DEVICE=/dev/md/menorah-backups
# Optional host group allowed to read backup status/archive metadata through the read-only admin API mount.
BACKUP_STATUS_GROUP=
BACKUP_MAX_AGE_HOURS=24
BACKUP_MIN_SIZE_BYTES=1024
BACKUP_DISK_USAGE_MAX_PERCENT=80
BACKUP_RESTORE_TEST_MAX_AGE_HOURS=24
BACKUP_COLD_STORAGE_LABEL="2 TB cold storage HDD"
SIX_HOURLY_RETENTION_DAYS=7
DAILY_RETENTION_DAYS=30
WEEKLY_RETENTION_DAYS=84
MONTHLY_RETENTION_DAYS=366
BACKUP_HEALTH_PUSH_URL=

# Required before production backups. Store the real value only in production.env.
BACKUP_ENCRYPTION_PASSWORD=
# Independent key for HMAC provenance/integrity; do not reuse encryption/audit keys.
BACKUP_INTEGRITY_HMAC_KEY=
