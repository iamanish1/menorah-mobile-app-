{
	email {$PUBLIC_EMAIL}
	# Cloudflare Tunnel terminates public TLS and connects to Caddy over the
	# private Docker network. Do not redirect this origin hop to HTTPS.
	auto_https off
	servers {
		# This is the single cloudflared address on tunnel_ingress_net, not a
		# public Cloudflare range or a broad Docker/private range.
		trusted_proxies static {$CLOUDFLARED_TUNNEL_IP}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(sanitized_reverse_proxy) {
	# Cloudflare always supplies a valid client IP on HTTP requests. If the
	# trusted connector reaches Caddy without one, fail closed instead of
	# collapsing every caller into the connector's rate-limit identity.
	@missing_tunnel_client_ip {
		remote_ip {$CLOUDFLARED_TUNNEL_IP}
		client_ip {$CLOUDFLARED_TUNNEL_IP}
	}
	respond @missing_tunnel_client_ip 400

	# A browser-provided country header is never authoritative. Only the
	# immediate cloudflared peer may promote Cloudflare's country result into
	# the private application header.
	@trusted_tunnel_country {
		remote_ip {$CLOUDFLARED_TUNNEL_IP}
		header_regexp CF-IPCountry ^(?:[A-Z][A-Z]|T1)$
	}
	request_header -X-Menorah-Client-Country
	request_header @trusted_tunnel_country X-Menorah-Client-Country {header.CF-IPCountry}

	# Strip every client-controlled forwarding/geolocation alias before the
	# request is sent to an application.
	request_header -Forwarded
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Port
	request_header -X-Real-IP
	request_header -True-Client-IP
	request_header -CF-Connecting-IP
	request_header -CF-IPCountry
	request_header -X-Vercel-IP-Country
	request_header -X-Country-Code
	request_header -X-Geo-Country

	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-Proto https
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(browser_call_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
}

(api_proxy) {
	import security_headers
	encode gzip zstd
	request_body {
		max_size 20MB
	}
}

(access_log) {
	log {
		output file {args[0]} {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

http://{$ROOT_DOMAIN}, http://{$WWW_DOMAIN} {
	import security_headers
	encode gzip zstd
	import sanitized_reverse_proxy landing-page:3002
	import access_log /var/log/caddy/www-access.log
}

http://{$APP_DOMAIN} {
	import browser_call_security_headers
	encode gzip zstd
	import sanitized_reverse_proxy user-web-app:3002
	import access_log /var/log/caddy/app-access.log
}

http://{$ADMIN_DOMAIN} {
	import security_headers
	encode gzip zstd
	import sanitized_reverse_proxy admin-panel:3003
	import access_log /var/log/caddy/admin-access.log
}

http://{$COUNSELLOR_DOMAIN} {
	import browser_call_security_headers
	encode gzip zstd
	import sanitized_reverse_proxy web-app:3001
	import access_log /var/log/caddy/counsellor-access.log
}

http://{$API_IOS_DOMAIN} {
	import api_proxy
	@reset_link path /api/auth/reset-password
	log_skip @reset_link
	route {
		@private_diagnostics path /metrics/* /health/deep
		respond @private_diagnostics 404
		import sanitized_reverse_proxy api-ios:8080
	}
	import access_log /var/log/caddy/api-ios-access.log
}

http://{$API_ANDROID_DOMAIN} {
	import api_proxy
	@reset_link path /api/auth/reset-password
