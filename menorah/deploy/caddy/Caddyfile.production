{
	email {$PUBLIC_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(cloudflare_origin_tls) {
	tls {$CLOUDFLARE_ORIGIN_CERT_FILE} {$CLOUDFLARE_ORIGIN_KEY_FILE}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(browser_call_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
}

(api_proxy) {
	import security_headers
	encode gzip zstd
	request_body {
		max_size 20MB
	}
}

(payment_disabled) {
	header Cache-Control "no-store, no-cache, max-age=0, must-revalidate"
	header Pragma "no-cache"
	header X-Content-Type-Options "nosniff"
	respond "Payments are temporarily disabled for final testing." 503
}

http://{$ROOT_DOMAIN}, http://{$WWW_DOMAIN}, http://{$APP_DOMAIN}, http://{$ADMIN_DOMAIN}, http://{$COUNSELLOR_DOMAIN}, http://{$API_IOS_DOMAIN}, http://{$API_ANDROID_DOMAIN}, http://{$API_WEB_DOMAIN}, http://{$API_ADMIN_DOMAIN}, http://{$CALLS_DOMAIN} {
	redir https://{host}{uri} permanent
}

{$ROOT_DOMAIN}, {$WWW_DOMAIN} {
	import cloudflare_origin_tls
	import security_headers
	encode gzip zstd
	reverse_proxy landing-page:3002
	log {
		output file /var/log/caddy/www-access.log
		format json
	}
}

{$APP_DOMAIN} {
	import cloudflare_origin_tls
	import browser_call_security_headers
	encode gzip zstd
	reverse_proxy user-web-app:3002
	log {
		output file /var/log/caddy/app-access.log
		format json
	}
}

{$ADMIN_DOMAIN} {
	import cloudflare_origin_tls
	import security_headers
	encode gzip zstd
	reverse_proxy admin-panel:3003
	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

{$COUNSELLOR_DOMAIN} {
	import cloudflare_origin_tls
	import browser_call_security_headers
	encode gzip zstd
	reverse_proxy web-app:3001
	log {
		output file /var/log/caddy/counsellor-access.log
		format json
	}
}

{$API_IOS_DOMAIN} {
	import cloudflare_origin_tls
	import api_proxy
	@payment path /api/payments* /api/payouts/webhook*
	handle @payment {
		import payment_disabled
	}
	handle {
		reverse_proxy api-ios:8080
	}
	log {
		output file /var/log/caddy/api-ios-access.log
		format json
	}
}

{$API_ANDROID_DOMAIN} {
	import cloudflare_origin_tls
	import api_proxy
	@payment path /api/payments* /api/payouts/webhook*
	handle @payment {
		import payment_disabled
	}
	handle {
		reverse_proxy api-android:8080
	}
	log {
		output file /var/log/caddy/api-android-access.log
		format json
	}
}

{$API_WEB_DOMAIN} {
	import cloudflare_origin_tls
	import api_proxy
	@payment path /api/payments* /api/payouts/webhook*
	handle @payment {
		import payment_disabled
	}
	handle {
		reverse_proxy api-web:8080
	}
	log {
		output file /var/log/caddy/api-web-access.log
		format json
	}
}

{$API_ADMIN_DOMAIN} {
	import cloudflare_origin_tls
	import api_proxy
	reverse_proxy api-admin:8080
	log {
		output file /var/log/caddy/api-admin-access.log
		format json
	}
}

{$CALLS_DOMAIN} {
	import cloudflare_origin_tls
	import browser_call_security_headers
	encode gzip zstd
	reverse_proxy {$LIVEKIT_UPSTREAM}
	log {
		output file /var/log/caddy/calls-access.log
		format json
	}
}

