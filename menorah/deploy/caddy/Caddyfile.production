{
	email {$PUBLIC_EMAIL}
	# Cloudflare Tunnel terminates public TLS and connects to Caddy over the
	# private Docker network. Do not redirect this origin hop to HTTPS.
	auto_https off
	servers {
		# This is the single cloudflared address on tunnel_ingress_net, not a
		# public Cloudflare range or a broad Docker/private range.
		trusted_proxies static {$CLOUDFLARED_TUNNEL_IP}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(sanitized_request) {
	# Cloudflare always supplies a valid client IP on HTTP requests. If the
	# trusted connector reaches Caddy without one, fail closed instead of
	# collapsing every caller into the connector's rate-limit identity.
	@missing_tunnel_client_ip {
		remote_ip {$CLOUDFLARED_TUNNEL_IP}
		client_ip {$CLOUDFLARED_TUNNEL_IP}
	}
	respond @missing_tunnel_client_ip 400

	# A browser-provided country header is never authoritative. Only the
	# immediate cloudflared peer may promote Cloudflare's country result into
	# the private application header.
	@trusted_tunnel_country {
		remote_ip {$CLOUDFLARED_TUNNEL_IP}
		header_regexp CF-IPCountry ^(?:[A-Z][A-Z]|T1)$
	}
	request_header -X-Menorah-Client-Country
	request_header @trusted_tunnel_country X-Menorah-Client-Country {header.CF-IPCountry}

	# Strip every client-controlled forwarding/geolocation alias before the
	# request is sent to an application.
	request_header -Forwarded
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Port
	request_header -X-Real-IP
	request_header -True-Client-IP
	request_header -CF-Connecting-IP
	request_header -CF-IPCountry
	request_header -X-Vercel-IP-Country
	request_header -X-Country-Code
	request_header -X-Geo-Country
}

(upstream_proxy) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-Proto https
	}
}

(sanitized_reverse_proxy) {
	import sanitized_request
	import upstream_proxy {args[0]}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(browser_call_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
}

(api_proxy) {
	import security_headers
	encode gzip zstd
	respond /metrics/* 404
	respond /health/deep 404
	request_body {
		max_size 20MB
	}
}

# Only the authenticated admin Reel-upload endpoint needs a larger body. Keep
# the rest of the API on the 20 MB default and preserve the trusted-proxy
# sanitisation boundary for this exceptional route.
(social_reel_upload_proxy) {
	import security_headers
	encode gzip zstd
	respond /metrics/* 404
	respond /health/deep 404
	request_body {
		max_size {$SOCIAL_STUDIO_MAX_VIDEO_REQUEST_SIZE_MB:55}MB
	}
}

# The signed browser-call document is the sole API response allowed to request
# camera and microphone access. Meeting tickets stay on the API origin.
(browser_call_api_proxy) {
	import browser_call_security_headers
	encode gzip zstd
	respond /metrics/* 404
	respond /health/deep 404
	request_body {
		max_size 20MB
	}
}

# This upstream fails closed with 404 until real platform signing identifiers
# are configured. Cloudflare's www-to-apex rule must exclude these two paths.
(app_link_associations) {
	@app_link_association path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @app_link_association {
		import upstream_proxy app-link-associations:8080
	}
}

(access_log) {
	log {
		output file {args[0]} {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

http://{$ROOT_DOMAIN}, http://{$WWW_DOMAIN} {
	import sanitized_request
	import security_headers
	import app_link_associations
	encode gzip zstd
	import upstream_proxy landing-page:3002
	import access_log /var/log/caddy/www-access.log
}

http://{$APP_DOMAIN} {
	import sanitized_request
	import browser_call_security_headers
	import app_link_associations
	encode gzip zstd
	# Provider callbacks and reset tokens are short-lived capabilities. Never
	# persist their query strings or relay cookies in reverse-proxy access logs.
	@checkout_sensitive path /checkout/callback /checkout/return /checkout/return/*
	log_skip @checkout_sensitive
	@password_reset_capability path /reset-password /reset-password/*
	log_skip @password_reset_capability
	import upstream_proxy user-web-app:3002
	import access_log /var/log/caddy/app-access.log
}

http://{$ADMIN_DOMAIN} {
	import sanitized_request
	import security_headers
	encode gzip zstd
	import upstream_proxy admin-panel:3003
	import access_log /var/log/caddy/admin-access.log
}

http://{$COUNSELLOR_DOMAIN} {
	import sanitized_request
	import browser_call_security_headers
	encode gzip zstd
	@password_reset_capability path /reset-password /reset-password/*
	log_skip @password_reset_capability
	import upstream_proxy web-app:3001
	import access_log /var/log/caddy/counsellor-access.log
}

http://{$API_IOS_DOMAIN} {
	import sanitized_request
	@password_reset_capability path /api/auth/reset-password /api/auth/reset-password/*
	log_skip @password_reset_capability
	@video_meet_page {
		method GET
		path /api/video/meet
	}
	handle @video_meet_page {
		import browser_call_api_proxy
		import upstream_proxy api-ios:8080
	}
	import app_link_associations
	handle {
		import api_proxy
		import upstream_proxy api-ios:8080
	}
	import access_log /var/log/caddy/api-ios-access.log
}

http://{$API_ANDROID_DOMAIN} {
	import sanitized_request
	@password_reset_capability path /api/auth/reset-password /api/auth/reset-password/*
	log_skip @password_reset_capability
	@video_meet_page {
		method GET
		path /api/video/meet
	}
	handle @video_meet_page {
		import browser_call_api_proxy
		import upstream_proxy api-android:8080
	}
	import app_link_associations
	handle {
		import api_proxy
		import upstream_proxy api-android:8080
	}
	import access_log /var/log/caddy/api-android-access.log
}

http://{$API_WEB_DOMAIN} {
	import sanitized_request
	@password_reset_capability path /api/auth/reset-password /api/auth/reset-password/*
	log_skip @password_reset_capability
	@video_meet_page {
		method GET
		path /api/video/meet
	}
	handle @video_meet_page {
		import browser_call_api_proxy
		import upstream_proxy api-web:8080
	}
	handle {
		import api_proxy
		import upstream_proxy api-web:8080
	}
	import access_log /var/log/caddy/api-web-access.log
}

http://{$API_ADMIN_DOMAIN} {
	import sanitized_request
	@social_reel_upload {
		method POST
		path /api/admin/social-studio/posts/video
	}
	handle @social_reel_upload {
		import social_reel_upload_proxy
		import upstream_proxy api-admin:8080
	}
	handle {
		import api_proxy
		import upstream_proxy api-admin:8080
	}
	import access_log /var/log/caddy/api-admin-access.log
}

http://{$CALLS_DOMAIN} {
	import sanitized_request
	import browser_call_security_headers
	encode gzip zstd
	import upstream_proxy {$LIVEKIT_UPSTREAM}
	import access_log /var/log/caddy/calls-access.log
}

http://mentle.org, http://www.mentle.org, http://mentle.mentle.org {
	import security_headers
	encode gzip zstd
	import sanitized_reverse_proxy mentle-landing-web:3101
	import access_log /var/log/caddy/mentle-www-access.log
}

http://app.mentle.org {
	import browser_call_security_headers
	encode gzip zstd
	import sanitized_reverse_proxy mentle-consumer-web:3100
	import access_log /var/log/caddy/mentle-app-access.log
}

http://business.mentle.org {
	import security_headers
	encode gzip zstd
	import sanitized_reverse_proxy mentle-business-portal:3102
	import access_log /var/log/caddy/mentle-business-access.log
}

http://admin.mentle.org {
	import security_headers
	encode gzip zstd
	import sanitized_reverse_proxy mentle-admin-panel:3103
	import access_log /var/log/caddy/mentle-admin-access.log
}

http://counsellor.mentle.org {
	import browser_call_security_headers
	encode gzip zstd
	import sanitized_reverse_proxy mentle-counsellor-portal:3104
	import access_log /var/log/caddy/mentle-counsellor-access.log
}

http://api.mentle.org {
	import api_proxy
	route {
		@private_diagnostics path /metrics/* /health/deep
		respond @private_diagnostics 404
		import sanitized_reverse_proxy mentle-api-consumer:4100
	}
	import access_log /var/log/caddy/mentle-api-access.log
}

http://api-business.mentle.org {
	import api_proxy
	route {
		@private_diagnostics path /metrics/* /health/deep
		respond @private_diagnostics 404
		import sanitized_reverse_proxy mentle-api-business:4101
	}
	import access_log /var/log/caddy/mentle-api-business-access.log
}

http://api-admin.mentle.org {
	import api_proxy
	route {
		@private_diagnostics path /metrics/* /health/deep
		respond @private_diagnostics 404
		import sanitized_reverse_proxy mentle-api-admin:4102
	}
	import access_log /var/log/caddy/mentle-api-admin-access.log
}

http://api-counsellor.mentle.org {
	import api_proxy
	route {
		@private_diagnostics path /metrics/* /health/deep
		respond @private_diagnostics 404
		import sanitized_reverse_proxy mentle-api-counsellor:4103
	}
	import access_log /var/log/caddy/mentle-api-counsellor-access.log
}

http://calls.mentle.org {
	import browser_call_security_headers
	encode gzip zstd
	import sanitized_reverse_proxy {$LIVEKIT_UPSTREAM}
	import access_log /var/log/caddy/mentle-calls-access.log
}
