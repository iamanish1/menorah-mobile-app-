# Copy this file to /opt/livekit/livekit.yaml on the Hostinger VPS.
# Never commit the real livekit.yaml because it contains API keys/secrets.
#
# Generate values:
#   LIVEKIT_API_KEY:    openssl rand -hex 16
#   LIVEKIT_API_SECRET: openssl rand -hex 32
#
# DNS:
#   calls.menorah.me -> Hostinger VPS public IP
#
# Hostinger firewall must allow:
#   80/tcp             Caddy certificate issuance/renewal
#   443/tcp            Browser HTTPS/WSS through Caddy
#   443/udp            HTTP/3 through Caddy
#   3478/udp           Embedded LiveKit TURN/UDP
#   5349/tcp           Coturn TURN/TLS
#   7881/tcp           LiveKit TCP fallback media
#   61000-62000/udp    LiveKit direct UDP media
# The TURN relay range 30000-31000 is internal between TURN and the SFU and
# must not be opened publicly.

port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  tcp_port: 7881
  port_range_start: 61000
  port_range_end: 62000
  use_external_ip: true
  turn_servers:
    - host: calls.menorah.me
      port: 5349
      protocol: tls
      secret: REPLACE_WITH_TURN_SHARED_SECRET
      ttl: 600

redis:
  address: redis:6379

# Keep embedded TURN/UDP for the normal relay path. TURN/TLS is provided by
# Coturn because LiveKit 1.13 advertises embedded TLS externally on port 443,
# which is already occupied by Caddy for HTTPS/WSS.
turn:
  enabled: true
  domain: calls.menorah.me
  udp_port: 3478
  tls_port: 0
  relay_range_start: 30000
  relay_range_end: 31000

keys:
  REPLACE_WITH_LIVEKIT_API_KEY: REPLACE_WITH_LIVEKIT_API_SECRET

room:
  auto_create: true

logging:
  # Avoid persisting SDP/ICE negotiation details in normal production logs.
  level: warn
