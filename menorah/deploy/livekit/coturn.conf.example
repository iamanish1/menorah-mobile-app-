# Copy to /opt/livekit/coturn.conf with mode 600. The shared secret must
# exactly match rtc.turn_servers[0].secret in livekit.yaml.

listening-port=5348
tls-listening-port=5349
listening-ip=REPLACE_WITH_HOSTINGER_PUBLIC_IPV4
relay-ip=REPLACE_WITH_HOSTINGER_PUBLIC_IPV4
external-ip=REPLACE_WITH_HOSTINGER_PUBLIC_IPV4
min-port=30000
max-port=31000
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_SHARED_SECRET
realm=calls.menorah.me
server-name=calls.menorah.me
cert=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/calls.menorah.me/calls.menorah.me.crt
pkey=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/calls.menorah.me/calls.menorah.me.key
proc-user=nobody
proc-group=nogroup
pidfile=/tmp/turnserver.pid
no-udp
no-dtls
no-tcp-relay
no-multicast-peers
stale-nonce=600
max-allocate-timeout=30
user-quota=12
total-quota=500
log-file=stdout
simple-log
